#!/usr/bin/env bash
#
# emulock-lab — live browser view of this machine's emulator reservations.
#
# Read-only. It enumerates the lock store, asks adb which emulators are
# actually attached, and lists the AVDs installed in the SDK. It never claims,
# releases, boots or targets a device, so it is safe to run alongside any
# number of agent sessions.
#
#   emulock-lab                 serve on 127.0.0.1:7337 and open a browser
#   emulock-lab --port 7400
#   emulock-lab --no-open       serve only
#   emulock-lab --json          one snapshot to stdout, then exit
#   emulock-lab --help
#
set -euo pipefail
# Resolve this script's real directory, following a chain of symlinks and
# resolving each relative link against the directory of the link itself.
# Homebrew installs bin/ entries as *relative* symlinks into ../Cellar/..., so
# a naive `readlink` + `cd` resolves against the caller's cwd and fails.
resolve_here() {
  local src="$1" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}
HERE="$(resolve_here "${BASH_SOURCE[0]}")"
exec python3 "$HERE/../libexec/device_lab.py" "$@"
