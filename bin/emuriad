#!/usr/bin/env bash
#
# emuriad — machine-wide emulator reservations for parallel agents.
#
# Lock store: ~/.emulator-locks/ (shared by every agent/worktree on this machine)
#   emulator-<port>/meta       one dir per device; mkdir is the atomic claim
#   emulator-<port>/last_used  lease heartbeat (refreshed by the guard hook)
#   avd-<name>/meta            one dir per AVD; two claims can never boot the same AVD
#
# Identity — resolved in this priority order by owner_id():
#   1. EMULATOR_LOCK_OWNER    explicit override, honoured first if set. For an
#                             external driver, or a harness whose shell exposes no
#                             stable per-session id of its own. Normally unset.
#   2. CLAUDE_CODE_SESSION_ID Claude Code exposes a stable per-session id directly
#                             in the shell environment. Recorded as "claude-code:<id>".
#   3. manual:$(id -un)       last resort for a bare human shell (no agent
#                             harness at all). Distinct from the above, so it can
#                             never collide with a real session.
#
# Enforcement — the guard hook (`emuriad guard`) shares this lock store. Wired as
# a Claude Code PreToolUse hook, it hard-blocks adb/emulator/Gradle commands that
# target serials the caller's session doesn't own, and refreshes the lease on
# every allowed command. Without a hook the locks still coordinate but nothing
# is blocked. `emuriad init` wires it for you, once, after asking.
#
# Usage:
#   emuriad check-in --pool [--window] [--additional] [--note TEXT]   a disposable pool instance
#   emuriad check-in [--avd NAME] [--require-booted] [--additional] [--note TEXT]
#   emuriad reclaim [--note TEXT]
#   emuriad check-out <serial> [--kill] [--force]
#   emuriad extend-stay <serial>
#   emuriad status
#   emuriad reap
#   emuriad pool status | bake [--window] [--apk PATH] | rebake    build the pool's golden snapshots
#   emuriad doctor                                      is emuriad installed and enforced?
#   emuriad doctor <serial> [VARIANT] [--fix] [--json]  is this device ready to test on?
#   emuriad evidence start|shot|note|stop|render ...    record proof of an on-device test
#   emuriad init [--project] [--dry-run] [--yes]        install the skill and wire the guard
#   emuriad guard                                       the PreToolUse hook itself (stdin: payload)
#   emuriad version
#
# claim, release and heartbeat, the names before 0.3.1, still work: they are the
# same commands as check-in, check-out and extend-stay.
#
# Multi-device claims: plain `check-in` is one-device-per-owner by default (the
# "already held" short-circuit below) -- a convenience default, not a security
# boundary. The real boundary is per-serial OWNER_ID, enforced by the guard
# hook. Pass `--additional` to claim a second (or Nth) device under this same
# identity -- e.g. a two-device test. Release each serial explicitly when done;
# `reclaim` only ever tracks your newest lock.
#
# Identity is the AVD name, not the port. Serial (emulator-5554) is assigned at
# boot and will change. After a crash, run `reclaim` (or `check-in --avd NAME`) —
# never re-run an old `-port 5554` command; that port may boot a different AVD.
#
# The pool: `check-in --pool` hands out a read-only instance of one AVD booted
# from its `golden` snapshot (`emuriad pool bake` makes it). `-read-only` lets
# several instances share the AVD and never saves back, so every instance
# starts identical and nothing an agent does survives it. That is why pool
# claims take no AVD lock, why `reclaim` of a pool lock takes ANY instance, and
# why a plain `claim` never hands one out (or boots a pool AVD writable).
# -read-only only resets on restart, so a pool instance is never passed to a
# second owner: release and reap shut it down, and every claim boots fresh
# (seconds, from the snapshot). At most `pool.max` pool locks at once.
#
# Headless by default. A snapshot only loads under the display setup it was
# saved with, so a device someone can watch needs its own snapshot:
# `emuriad pool bake --window` saves `golden-window` from a windowed boot, and
# `check-in --pool --window` boots from it with a window. Each snapshot refuses
# the other mode (the emulator deletes a snapshot it cannot load; the guard
# refuses the mismatched boot, and both are read-only on disk).
#
# Staleness (auto-reclaimed by claim/reap) is lease-based, not a blind TTL:
#   - device absent from `adb devices` and no activity for 10 min (boot grace)
#   - no activity for EMULATOR_LOCK_IDLE_TTL seconds (default 14400 = 4 h),
#     even if the device is still running
# "Activity" = last_used mtime, refreshed by the guard hook whenever the owning
# session touches the device. An agent actively using its emulator is never reaped.
#
# Project config: <repo>/.emuriad/config, `key = value` lines, read from the git
# checkout of the current directory. Every key can be overridden by an
# EMURIAD_<KEY> variable (dots become underscores: pool.avd -> EMURIAD_POOL_AVD).
# The pre-rename names still work: .emulock/ when there is no .emuriad/, and
# EMULOCK_<KEY> when EMURIAD_<KEY> is unset.
# The keys that matter here: pool.avd (default emulock_pool), pool.max (3).
# `emuriad pool --help` and `emuriad doctor --help` list the rest.
#
# Environment:
#   EMULATOR_LOCK_OWNER     owner identity override
#   EMULATOR_LOCK_DIR       lock store         (default: ~/.emulator-locks)
#   EMULATOR_LOCK_IDLE_TTL  idle lease seconds (default: 14400)
#   ANDROID_HOME            SDK root           (default: probed)
#   ANDROID_AVD_HOME        AVD directory      (default: ~/.android/avd)
#
# Options (global): --dry-run --help --version

set -euo pipefail

VERSION="0.3.2"
LOCK_ROOT="${EMULATOR_LOCK_DIR:-$HOME/.emulator-locks}"
IDLE_TTL="${EMULATOR_LOCK_IDLE_TTL:-14400}"
BOOT_GRACE=600
sdk_root() {
  local c
  for c in "$ANDROID_HOME" "$ANDROID_SDK_ROOT" \
           "$HOME/Library/Android/sdk" "$HOME/Android/Sdk"; do
    [[ -n "$c" && -d "$c" ]] && { printf '%s' "$c"; return 0; }
  done
  printf '%s' "$HOME/Library/Android/sdk"
}
SDK="$(ANDROID_HOME="${ANDROID_HOME:-}" ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-}" sdk_root)"
EMU_BIN="$SDK/emulator/emulator"
AVD_HOME="${ANDROID_AVD_HOME:-$HOME/.android/avd}"
POOL_SNAPSHOT="golden"
POOL_SNAPSHOT_WINDOW="golden-window"
DRY_RUN=0

die() { echo "emuriad: $*" >&2; exit 1; }
# Print the header comment block as help. Reads to the end of the block rather
# than a fixed line range, so the help never silently loses what the header gains.
usage() { awk 'NR>1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$0"; }

# Resolve this script's real directory, following a chain of symlinks and
# resolving each relative link against the directory of the link itself.
# Homebrew installs bin/ entries as *relative* symlinks into ../Cellar/..., so
# a naive `readlink` + `cd` resolves against the caller's cwd and fails.
resolve_here() {
  local src="$1" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}
HERE="$(resolve_here "${BASH_SOURCE[0]}")"
SELF="$HERE/$(basename "${BASH_SOURCE[0]}")"

# First existing path among the candidates, normalised (no ../) so it can be pasted.
first_existing() {
  local candidate
  for candidate in "$@"; do
    [[ -e "$candidate" ]] || continue
    printf '%s/%s' "$(cd "$(dirname "$candidate")" && pwd)" "$(basename "$candidate")"
    return 0
  done
  return 1
}
# Repo checkout, Homebrew (pkgshare), then where install.sh links to.
share_path() { # share_path <relative path under the share dir>
  first_existing "$HERE/../$1" "$HERE/../share/emuriad/$1" "$HOME/.local/share/emuriad/$1"
}
guard_path() { share_path hooks/claude-code/emuriad-guard.sh; }
libexec_path() { first_existing "$HERE/../libexec/$1"; }

# --- project config -------------------------------------------------------------

project_root() { git rev-parse --show-toplevel 2>/dev/null || pwd; }

# The project's config directory: .emuriad/, or .emulock/ from before the rename.
conf_dir() { # conf_dir <root>
  if [[ ! -d "$1/.emuriad" && -d "$1/.emulock" ]]; then printf '%s' "$1/.emulock"; else printf '%s' "$1/.emuriad"; fi
}

# conf_get <key> [default]: EMURIAD_<KEY> env (or the old EMULOCK_<KEY>), else the
# project's config file, else default.
conf_get() {
  local key="$1" def="${2:-}" env_name val="" file
  env_name="$(printf '%s' "$key" | tr '[:lower:].-' '[:upper:]__')"
  val="$(printenv "EMURIAD_$env_name" || printenv "EMULOCK_$env_name" || true)"
  if [[ -z "$val" ]]; then
    file="$(conf_dir "$(project_root)")/config"
    if [[ -f "$file" ]]; then
      val="$(awk -v k="$key" '
        { line = $0; sub(/^[ \t]+/, "", line) }
        line == "" || line ~ /^#/ { next }
        { i = index(line, "="); if (!i) next
          name = substr(line, 1, i - 1); v = substr(line, i + 1)
          sub(/[ \t]+#.*$/, "", v)
          gsub(/^[ \t]+|[ \t]+$/, "", name); gsub(/^[ \t]+|[ \t]+$/, "", v)
          if (name == k) { print v; exit } }' "$file")"
    fi
  fi
  printf '%s' "${val:-$def}"
}

# Loaded in main, after the guard fast path: the hook must not pay for git + awk.
# EMULATOR_POOL_* are the names these settings had before they moved into config.
POOL_AVD=""
POOL_MAX=3
load_pool_config() {
  POOL_AVD="${EMULATOR_POOL_AVD:-$(conf_get pool.avd emulock_pool)}"
  POOL_MAX="${EMULATOR_POOL_MAX:-$(conf_get pool.max 3)}"
}

# --- helpers --------------------------------------------------------------------

require_adb() { command -v adb >/dev/null 2>&1 || die "adb not on PATH — install Android platform-tools"; }

now() { date +%s; }

owner_id() {
  if [[ -n "${EMULATOR_LOCK_OWNER:-}" ]]; then
    echo "$EMULATOR_LOCK_OWNER"                        # explicit override
  elif [[ -n "${CLAUDE_CODE_SESSION_ID:-}" ]]; then
    echo "claude-code:$CLAUDE_CODE_SESSION_ID"          # Claude Code, native env var
  else
    echo "manual:$(id -un)"                             # bare shell, no agent harness
  fi
}
owner_worktree() { git rev-parse --show-toplevel 2>/dev/null || pwd; }
owner_branch() { git branch --show-current 2>/dev/null || echo "?"; }

# Serials adb knows about, any state (device/offline/unauthorized).
adb_all_serials() {
  adb devices 2>/dev/null | awk 'NR>1 && $1 ~ /^emulator-/ {print $1}'
}

# Serials fully online.
adb_booted_serials() {
  adb devices 2>/dev/null | awk 'NR>1 && $2=="device" && $1 ~ /^emulator-/ {print $1}'
}

meta_get() { # meta_get <lockname> <KEY>   (lockname: emulator-5554 or avd-Name)
  local f="$LOCK_ROOT/$1/meta"
  [[ -f "$f" ]] && sed -n "s/^$2=//p" "$f" || true
}

# BSD stat (macOS) and GNU stat (Linux) spell this differently and neither
# accepts the other's flag, so try both rather than branching on uname.
file_mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo ""; }

# Seconds since last activity (last_used mtime, else CREATED_AT), or empty.
lease_age() { # lease_age <serial>
  local d="$LOCK_ROOT/$1" ts=""
  [[ -f "$d/last_used" ]] && ts="$(file_mtime "$d/last_used")"
  [[ -z "$ts" ]] && ts="$(meta_get "$1" CREATED_AT)"
  [[ -n "$ts" ]] && echo $(( $(now) - ts )) || echo ""
}

# This owner's lock (newest if somehow more than one). Empty if none.
find_our_lock() {
  local d serial best="" best_ts=0 ts me
  [[ -d "$LOCK_ROOT" ]] || return 0
  me="$(owner_id)"
  for d in "$LOCK_ROOT"/emulator-*; do
    [[ -d "$d" ]] || continue
    serial="$(basename "$d")"
    [[ "$(meta_get "$serial" OWNER_ID)" == "$me" ]] || continue
    ts="$(meta_get "$serial" CREATED_AT)"
    ts="${ts:-0}"
    if (( ts >= best_ts )); then
      best="$serial"
      best_ts="$ts"
    fi
  done
  echo "$best"
}

avd_of_serial() { # AVD name of a running emulator (best effort)
  adb -s "$1" emu avd name 2>/dev/null | head -n1 | tr -d '\r' || true
}

# A pool AVD is one `emuriad pool bake` created or baked (it leaves a marker in
# the AVD directory; emulock-pool before the rename), or the one this project's config names. Plain claims never
# take one, and a pool instance left running with no lock is shut down by reap.
is_pool_avd() { # is_pool_avd <avd>
  [[ -n "$1" ]] || return 1
  [[ "$1" == "$POOL_AVD" || -f "$AVD_HOME/$1.avd/emuriad-pool" || -f "$AVD_HOME/$1.avd/emulock-pool" \
    || -f "$AVD_HOME/$1.avd/golden.json" ]]
}

is_stale() { # is_stale <serial> — 0 = stale
  local serial="$1" age
  age="$(lease_age "$serial")"
  [[ -z "$age" ]] && return 0                     # no/broken meta → stale
  (( age > IDLE_TTL )) && return 0                # idle too long, even if booted
  if ! adb_all_serials | grep -qx "$serial"; then
    (( age > BOOT_GRACE )) && return 0            # never booted / died
  fi
  return 1
}

avd_lock_dir() { echo "$LOCK_ROOT/avd-$1"; }

try_avd_lock() { # try_avd_lock <avd> <serial> — 0 = we got it
  local avd="$1" serial="$2"
  mkdir "$(avd_lock_dir "$avd")" 2>/dev/null || return 1
  cat > "$(avd_lock_dir "$avd")/meta" <<EOF
AVD=$avd
SERIAL=$serial
OWNER_ID=$(owner_id)
CREATED_AT=$(now)
EOF
}

is_pool_lock() { [[ "$(meta_get "$1" POOL)" == 1 ]]; }

release_avd_lock_of() { # release_avd_lock_of <serial>
  local avd
  # Pool instances share their AVD and never hold its lock — never delete one on their behalf.
  is_pool_lock "$1" && return 0
  avd="$(meta_get "$1" AVD)"
  [[ -n "$avd" && "$avd" != "unknown" ]] && rm -rf "$(avd_lock_dir "$avd")"
  return 0
}

drop_lock() { # drop_lock <serial> — serial lock + its AVD lock
  release_avd_lock_of "$1"
  rm -rf "$LOCK_ROOT/$1"
}

reap_stale() { # reap_stale [verbose]
  local verbose="${1:-}" d serial avd paired
  [[ -d "$LOCK_ROOT" ]] || return 0
  for d in "$LOCK_ROOT"/emulator-*; do
    [[ -d "$d" ]] || continue
    serial="$(basename "$d")"
    if is_stale "$serial"; then
      if [[ "$DRY_RUN" == 1 ]]; then
        [[ -n "$verbose" ]] && echo "[dry-run] would reap stale lock: $serial"
      else
        local owner
        owner="$(meta_get "$serial" OWNER_BRANCH)"
        drop_lock "$serial"   # a pool instance left running is shut down by the leftover sweep below
        [[ -n "$verbose" ]] && echo "reaped stale lock: $serial (owner: ${owner:-?})"
      fi
    fi
  done
  # Leftover pool instances: running with no lock means nobody owns them, and whatever
  # their last owner did is still inside. Nothing may reuse them, so shut them down.
  for serial in $(adb_booted_serials); do
    [[ -d "$LOCK_ROOT/$serial" ]] && continue
    is_pool_avd "$(avd_of_serial "$serial")" || continue
    if [[ "$DRY_RUN" == 1 ]]; then
      [[ -n "$verbose" ]] && echo "[dry-run] would shut down leftover pool instance: $serial"
    else
      adb -s "$serial" emu kill >/dev/null 2>&1 || true
      [[ -n "$verbose" ]] && echo "shut down leftover pool instance: $serial"
    fi
  done
  # Orphan AVD locks: their serial lock is gone.
  for d in "$LOCK_ROOT"/avd-*; do
    [[ -d "$d" ]] || continue
    avd="$(basename "$d")"
    paired="$(meta_get "$avd" SERIAL)"
    if [[ -z "$paired" || ! -d "$LOCK_ROOT/$paired" ]]; then
      if [[ "$DRY_RUN" == 1 ]]; then
        [[ -n "$verbose" ]] && echo "[dry-run] would reap orphan AVD lock: $avd"
      else
        rm -rf "$d"
        [[ -n "$verbose" ]] && echo "reaped orphan AVD lock: $avd"
      fi
    fi
  done
  return 0
}

write_meta() { # write_meta <serial> <avd> <port> <state> <note> [pool: 1] [snapshot]
  cat > "$LOCK_ROOT/$1/meta" <<EOF
SERIAL=$1
AVD=$2
PORT=$3
STATE=$4
OWNER_ID=$(owner_id)
OWNER_WORKTREE=$(owner_worktree)
OWNER_BRANCH=$(owner_branch)
NOTE=$5
POOL=${6:-0}
POOL_SNAPSHOT=${7:-}
CREATED_AT=$(now)
EOF
  touch "$LOCK_ROOT/$1/last_used"
}

pool_lock_count() {
  local d n=0
  for d in "$LOCK_ROOT"/emulator-*; do
    [[ -d "$d" ]] || continue
    is_pool_lock "$(basename "$d")" && n=$((n + 1))
  done
  echo "$n"
}

pool_snapshot_ready() { [[ -d "$AVD_HOME/$POOL_AVD.avd/snapshots/${1:-$POOL_SNAPSHOT}" ]]; }
pool_snapshot_of() { # the snapshot a pool lock was booted from (older locks: golden)
  local snap
  snap="$(meta_get "$1" POOL_SNAPSHOT)"
  echo "${snap:-$POOL_SNAPSHOT}"
}

try_lock() { # atomic; 0 = we got it
  mkdir "$LOCK_ROOT/$1" 2>/dev/null
}

avd_api_level() { # digits from image.sysdir.1=system-images/android-NN...
  local ini="$AVD_HOME/$1.avd/config.ini"
  [[ -f "$ini" ]] || { echo ""; return; }
  sed -n 's|^image\.sysdir\.1 *= *system-images/android-\([0-9]*\).*|\1|p' "$ini" | head -n1
}

boot_command() { # boot_command <avd> <port>
  local avd="$1" port="$2" api flags="-port $port -no-boot-anim"
  api="$(avd_api_level "$avd")"
  # Unknown API → assume flags needed (boot rule: "when in doubt, add them").
  if [[ -z "$api" || "$api" -ge 36 ]]; then
    flags="$flags -gpu host -feature -GuestAngle"
  fi
  echo "$EMU_BIN @$avd $flags"
}

pool_boot_command() { # pool_boot_command <port> [window: 0|1]
  # -force-snapshot-load: a missing or broken snapshot must fail loudly, never
  # cold-boot a blank device that merely looks like a pool instance.
  # Never a -gpu flag, and the window setting of the snapshot's own bake: a
  # snapshot only loads under the renderer and features it was saved with. Any
  # other and the emulator deletes it (the guard hook denies that). The API-36
  # GPU workaround is left out for the same reason: the pool image has to be
  # one that boots without it.
  if [[ "${2:-0}" == 1 ]]; then
    echo "$EMU_BIN @$POOL_AVD -port $1 -no-boot-anim -read-only -snapshot $POOL_SNAPSHOT_WINDOW -force-snapshot-load -no-snapshot-save"
  else
    echo "$EMU_BIN @$POOL_AVD -port $1 -no-boot-anim -read-only -snapshot $POOL_SNAPSHOT -force-snapshot-load -no-snapshot-save -no-window"
  fi
}

avds_in_use() { # AVDs held by locks or running emulators
  local d serial
  for d in "$LOCK_ROOT"/avd-*; do
    [[ -d "$d" ]] && basename "$d" | sed 's/^avd-//'
  done
  for d in "$LOCK_ROOT"/emulator-*; do
    [[ -d "$d" ]] && meta_get "$(basename "$d")" AVD
  done
  for serial in $(adb_booted_serials); do
    avd_of_serial "$serial"
  done
}

print_boot_hint() { # print_boot_hint <serial> <avd>
  echo "identity is AVD $2 — do not relaunch by port; next boot may be a different serial"
  echo "relaunch after crash: emuriad reclaim"
  echo "use it as: adb -s $1 ..."
}

print_pool_hint() { # print_pool_hint <serial>
  echo "pool instances are identical and disposable: nothing you change survives, and after a crash any instance will do"
  echo "relaunch after crash: emuriad reclaim"
  echo "use it as: adb -s $1 ..."
}

# When a claim cannot be satisfied, say when one frees up. Without this an agent
# is told only that it failed, which invites a retry loop; with it, the correct
# move (wait, or tell the human) is obvious from the message itself.
next_free_hint() {
  local now soonest="" d idle left h m
  now="$(now)"
  for d in "$LOCK_ROOT"/emulator-*; do
    [[ -d "$d" ]] || continue
    idle="$(lease_age "${d##*/}")"
    [[ -z "$idle" ]] && continue
    [[ "$idle" -ge "$IDLE_TTL" ]] && { echo "A lease has already expired — run: emuriad reap, then claim again."; return 0; }
    left=$(( IDLE_TTL - idle ))
    if [[ -z "$soonest" || "$left" -lt "$soonest" ]]; then soonest="$left"; fi
  done
  [[ -z "$soonest" ]] && { echo "Run: emuriad status"; return 0; }
  h=$(( soonest / 3600 )); m=$(( (soonest % 3600) / 60 ))
  if [[ "$h" -gt 0 ]]; then
    echo "The earliest lease frees in ${h}h ${m}m. Tell the user rather than taking a device that isn't yours."
  else
    echo "The earliest lease frees in ${m}m. Tell the user rather than taking a device that isn't yours."
  fi
}

# --- claim ----------------------------------------------------------------------

# Pool claims. Any instance is as good as another, so there is no AVD lock and
# no "keep your AVD" — only a port and the cap.
#
# A running instance is never handed to a second owner. -read-only only resets
# on restart, so an instance someone used carries their APK, login and state
# until it is shut down — reusing it would break "every instance starts from
# golden". Releasing (and reaping) a pool instance shuts it down instead.
claim_pool() { # claim_pool <note> <additional: 0|1> <window: 0|1>
  local note="$1" additional="${2:-0}" window="${3:-0}" our_serial="" port candidate all_serials in_use serial
  local snapshot="$POOL_SNAPSHOT" mode="headless"
  if [[ "$window" == 1 ]]; then snapshot="$POOL_SNAPSHOT_WINDOW"; mode="with a window"; fi
  (( additional )) || our_serial="$(find_our_lock)"
  # A held instance of the other mode is not what was asked for, and cannot be
  # turned into it: the display is fixed at boot.
  if [[ -n "$our_serial" ]] && is_pool_lock "$our_serial" \
    && [[ "$(pool_snapshot_of "$our_serial")" != "$snapshot" ]] && adb_all_serials | grep -qx "$our_serial"; then
    die "check-in --pool: you hold $our_serial, booted from '$(pool_snapshot_of "$our_serial")' — release it first (emuriad check-out $our_serial), or keep it and add this one with --additional"
  fi
  if [[ -n "$our_serial" ]] && is_pool_lock "$our_serial"; then
    if adb_booted_serials | grep -qx "$our_serial"; then
      touch "$LOCK_ROOT/$our_serial/last_used"
      echo "claimed: $our_serial (already held, pool instance of $POOL_AVD from '$(pool_snapshot_of "$our_serial")')"
      print_pool_hint "$our_serial"
      return 0
    fi
    if adb_all_serials | grep -qx "$our_serial"; then
      touch "$LOCK_ROOT/$our_serial/last_used"
      echo "claimed: $our_serial (already held, pool instance of $POOL_AVD, device offline — wait for boot)"
      echo "use it as: adb -s $our_serial wait-for-device"
      return 0
    fi
    echo "emuriad: pool instance $our_serial is gone; claiming a fresh one" >&2
    if [[ "$DRY_RUN" == 1 ]]; then
      echo "[dry-run] would drop dead lock $our_serial"
    else
      drop_lock "$our_serial"
    fi
  fi

  reap_stale

  # Always a fresh boot from the snapshot (seconds), within the cap.
  if ! pool_snapshot_ready "$snapshot"; then
    [[ "$window" == 1 ]] && die "check-in --pool --window: no '$snapshot' snapshot on AVD $POOL_AVD — bake it first (a window opens for a few minutes): emuriad pool bake --window"
    die "check-in --pool: no '$snapshot' snapshot on AVD $POOL_AVD — bake it first: emuriad pool bake"
  fi
  in_use="$(pool_lock_count)"
  (( in_use < POOL_MAX )) || die "check-in --pool: the pool is full ($in_use/$POOL_MAX). $(next_free_hint)"
  all_serials="$(adb_all_serials)"
  port=""
  for candidate in $(seq 5554 2 5584); do
    echo "$all_serials" | grep -qx "emulator-$candidate" && continue
    [[ -d "$LOCK_ROOT/emulator-$candidate" ]] && continue
    if [[ "$DRY_RUN" == 1 ]]; then port="$candidate"; break; fi
    if try_lock "emulator-$candidate"; then port="$candidate"; break; fi
  done
  [[ -z "$port" ]] && die "check-in --pool: every emulator port (5554-5584) is reserved. $(next_free_hint)"
  serial="emulator-$port"

  if [[ "$DRY_RUN" == 1 ]]; then
    echo "[dry-run] would claim: $serial (boot a pool instance of $POOL_AVD, $mode)"
    echo "[dry-run] boot command: $(pool_boot_command "$port" "$window")"
    return 0
  fi
  # Re-count now that the port is ours: a concurrent claim may have filled the pool.
  if (( $(pool_lock_count) >= POOL_MAX )); then
    rm -rf "$LOCK_ROOT/$serial"
    die "check-in --pool: the pool filled up while claiming ($POOL_MAX/$POOL_MAX) — retry after a release"
  fi
  write_meta "$serial" "$POOL_AVD" "$port" "booting" "$note" 1 "$snapshot"
  echo "claimed: $serial (boot needed, pool instance of $POOL_AVD, $mode)"
  echo "boot command (run as long-lived background shell; loads the '$snapshot' snapshot, $mode):"
  echo "  $(pool_boot_command "$port" "$window")"
  echo "copy it verbatim: changing the window or GPU flags deletes the shared '$snapshot' snapshot for every agent"
  echo "then wait for boot:"
  echo "  adb -s $serial wait-for-device"
  print_pool_hint "$serial"
}

cmd_claim() {
  local want_avd="" require_booted=0 note="" serial avd port used_avds candidate
  local our_serial our_avd released_avd="" additional=0 pool=0 window=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --pool) pool=1; shift ;;
    --window) window=1; shift ;;
    --avd) want_avd="$2"; shift 2 ;;
    --require-booted) require_booted=1; shift ;;
    --additional) additional=1; shift ;;
    --note) note="$2"; shift 2 ;;
    *) die "check-in: unknown option $1" ;;
    esac
  done

  mkdir -p "$LOCK_ROOT"

  if (( pool )); then
    [[ -z "$want_avd" ]] || die "check-in: --pool and --avd are exclusive (the pool always uses $POOL_AVD)"
    claim_pool "$note" "$additional" "$window"
    return
  fi
  (( window )) && die "check-in: --window is for pool instances (check-in --pool --window); a named AVD boots with a window already"

  # AVD name is identity. If this owner already reserved one, keep it —
  # even when the qemu process died and the old serial/port is gone.
  # --additional opts out: reserve a genuinely new device instead.
  our_serial=""
  (( additional )) || our_serial="$(find_our_lock)"
  # A held pool instance stays a pool claim: reviving it through the AVD path
  # below would boot the pool AVD writable and let the next instance inherit it.
  if [[ -n "$our_serial" ]] && is_pool_lock "$our_serial"; then
    local held_window=0
    [[ "$(pool_snapshot_of "$our_serial")" == "$POOL_SNAPSHOT_WINDOW" ]] && held_window=1
    claim_pool "$note" 0 "$held_window"
    return
  fi
  if [[ -n "$our_serial" ]]; then
    our_avd="$(meta_get "$our_serial" AVD)"
    if adb_booted_serials | grep -qx "$our_serial"; then
      touch "$LOCK_ROOT/$our_serial/last_used"
      echo "claimed: $our_serial (already held, avd: ${our_avd:-?})"
      print_boot_hint "$our_serial" "${our_avd:-?}"
      return 0
    fi
    if adb_all_serials | grep -qx "$our_serial"; then
      touch "$LOCK_ROOT/$our_serial/last_used"
      echo "claimed: $our_serial (already held, avd: ${our_avd:-?}, device offline — wait for boot)"
      echo "use it as: adb -s $our_serial wait-for-device"
      return 0
    fi
    if [[ -z "$want_avd" && -n "$our_avd" && "$our_avd" != "unknown" ]]; then
      want_avd="$our_avd"
    fi
    released_avd="$our_avd"
    echo "emuriad: $our_serial is gone; reclaiming AVD ${want_avd:-?} (port may change)" >&2
    if [[ "$DRY_RUN" == 1 ]]; then
      echo "[dry-run] would drop dead lock $our_serial and boot AVD ${want_avd:-?}"
    else
      drop_lock "$our_serial"
    fi
  fi

  reap_stale

  # 1) Reuse a booted, unclaimed emulator (enforcement makes "unclaimed" mean
  #    genuinely free — hooked agents cannot use a device without a lock).
  for serial in $(adb_booted_serials); do
    [[ -d "$LOCK_ROOT/$serial" ]] && continue
    avd="$(avd_of_serial "$serial")"
    is_pool_avd "$avd" && continue   # pool instances are handed out by --pool only
    [[ -n "$want_avd" && "$avd" != "$want_avd" ]] && continue
    # AVD reserved by someone else (e.g. mid-boot on another port) → not free.
    [[ -n "$avd" && -d "$(avd_lock_dir "$avd")" ]] && continue
    if [[ "$DRY_RUN" == 1 ]]; then
      echo "[dry-run] would claim: $serial (reuse running emulator, avd: ${avd:-?})"
      return 0
    fi
    if try_lock "$serial"; then
      if [[ -n "$avd" ]] && ! try_avd_lock "$avd" "$serial"; then
        rm -rf "$LOCK_ROOT/$serial"   # lost the AVD race — try the next device
        continue
      fi
      write_meta "$serial" "${avd:-unknown}" "${serial#emulator-}" "running" "$note"
      echo "claimed: $serial (reused running emulator, avd: ${avd:-?})"
      print_boot_hint "$serial" "${avd:-?}"
      return 0
    fi
  done

  (( require_booted )) && die "check-in: no free booted emulator (--require-booted)"

  # 2) Reserve a free port + free AVD, hand back the boot command.
  local all_serials
  all_serials="$(adb_all_serials)"
  port=""
  for candidate in $(seq 5554 2 5584); do
    echo "$all_serials" | grep -qx "emulator-$candidate" && continue
    [[ -d "$LOCK_ROOT/emulator-$candidate" ]] && continue
    if [[ "$DRY_RUN" == 1 ]]; then port="$candidate"; break; fi
    if try_lock "emulator-$candidate"; then port="$candidate"; break; fi
  done
  [[ -z "$port" ]] && die "check-in: every emulator port (5554-5584) is reserved. $(next_free_hint)"
  serial="emulator-$port"

  used_avds="$(avds_in_use)"
  # Dead lock for this owner was dropped (or would be); that AVD is ours again.
  if [[ -n "$released_avd" && "$released_avd" != "unknown" ]]; then
    used_avds="$(printf '%s\n' $used_avds | grep -vx "$released_avd" || true)"
  fi
  avd=""
  if [[ -n "$want_avd" ]]; then
    if ! "$EMU_BIN" -list-avds 2>/dev/null | grep -qx "$want_avd"; then
      [[ "$DRY_RUN" == 1 ]] || rm -rf "$LOCK_ROOT/$serial"
      die "check-in: no such AVD '$want_avd'"
    fi
    if echo "$used_avds" | grep -qx "$want_avd"; then
      [[ "$DRY_RUN" == 1 ]] || rm -rf "$LOCK_ROOT/$serial"
      die "check-in: AVD '$want_avd' is in use by another lock or running emulator"
    fi
    if [[ "$DRY_RUN" != 1 ]] && ! try_avd_lock "$want_avd" "$serial"; then
      rm -rf "$LOCK_ROOT/$serial"
      die "check-in: AVD '$want_avd' was locked by another agent just now — retry"
    fi
    avd="$want_avd"
  else
    for candidate in $("$EMU_BIN" -list-avds 2>/dev/null); do
      is_pool_avd "$candidate" && continue   # only `emuriad pool bake` boots it writable, by name
      echo "$used_avds" | grep -qx "$candidate" && continue
      if [[ "$DRY_RUN" == 1 ]]; then avd="$candidate"; break; fi
      # mkdir on the AVD lock is the atomic tie-break between concurrent claims.
      if try_avd_lock "$candidate" "$serial"; then avd="$candidate"; break; fi
    done
  fi
  if [[ -z "$avd" ]]; then
    [[ "$DRY_RUN" == 1 ]] || rm -rf "$LOCK_ROOT/$serial"
    die "check-in: every installed AVD is in use. Create another AVD, or wait. $(next_free_hint)"
  fi

  if [[ "$DRY_RUN" == 1 ]]; then
    echo "[dry-run] would claim: $serial (boot needed, avd: $avd)"
    echo "[dry-run] boot command: $(boot_command "$avd" "$port")"
    echo "[dry-run] identity is AVD $avd — relaunch with: emuriad reclaim"
    return 0
  fi

  write_meta "$serial" "$avd" "$port" "booting" "$note"
  echo "claimed: $serial (boot needed, avd: $avd)"
  echo "boot command (run as long-lived background shell; add -no-snapshot-load for cold boot):"
  echo "  $(boot_command "$avd" "$port")"
  echo "then wait for boot:"
  echo "  adb -s $serial wait-for-device"
  print_boot_hint "$serial" "$avd"
}

cmd_reclaim() {
  local note=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --note) note="$2"; shift 2 ;;
    *) die "reclaim: unknown option $1" ;;
    esac
  done
  mkdir -p "$LOCK_ROOT"
  local our_serial avd
  our_serial="$(find_our_lock)"
  [[ -n "$our_serial" ]] || die "reclaim: this session has no prior claim. Use: emuriad check-in [--pool | --avd NAME]"
  if is_pool_lock "$our_serial"; then
    echo "reclaiming a pool instance (previous serial $our_serial; any instance will do)"
    if [[ "$(pool_snapshot_of "$our_serial")" == "$POOL_SNAPSHOT_WINDOW" ]]; then
      cmd_claim --pool --window --note "$note"
    else
      cmd_claim --pool --note "$note"
    fi
    return
  fi
  avd="$(meta_get "$our_serial" AVD)"
  [[ -n "$avd" && "$avd" != "unknown" ]] || die "reclaim: lock $our_serial has no AVD name — pass check-in --avd NAME"
  echo "reclaiming AVD $avd (previous serial $our_serial; port may change)"
  if [[ -n "$note" ]]; then
    cmd_claim --avd "$avd" --note "$note"
  else
    cmd_claim --avd "$avd"
  fi
}

cmd_release() {
  local serial="" kill=0 force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --kill) kill=1; shift ;;
    --force) force=1; shift ;;
    -*) die "check-out: unknown option $1" ;;
    *) serial="$1"; shift ;;
    esac
  done
  [[ -n "$serial" ]] || die "check-out: serial required (e.g. emulator-5554)"
  [[ -d "$LOCK_ROOT/$serial" ]] || { echo "check-out: no lock for $serial (nothing to do)"; return 0; }

  local lock_owner
  lock_owner="$(meta_get "$serial" OWNER_ID)"
  if [[ -n "$lock_owner" && "$lock_owner" != "$(owner_id)" && "$force" != 1 ]]; then
    die "check-out: $serial is owned by another agent ($lock_owner, branch: $(meta_get "$serial" OWNER_BRANCH)). Use --force only if you are sure."
  fi

  # A pool instance is always shut down on release: -read-only only resets on
  # restart, so a running one would hand its state to whoever came next.
  local pool_instance=0
  is_pool_lock "$serial" && pool_instance=1
  if [[ "$DRY_RUN" == 1 ]]; then
    echo "[dry-run] would release $serial$( ((kill || pool_instance)) && echo ' and kill the emulator')"
    return 0
  fi
  if (( kill || pool_instance )); then
    adb -s "$serial" emu kill >/dev/null 2>&1 || true
    if (( pool_instance )); then
      echo "shut down pool instance $serial (disposable — the next claim boots a fresh one)"
    else
      echo "killed emulator $serial"
    fi
  fi
  drop_lock "$serial"
  echo "released: $serial"
}

cmd_heartbeat() { # refresh the lease (for wrapper scripts holding a device)
  local serial="${1:-}"
  [[ -n "$serial" ]] || die "extend-stay: serial required"
  [[ -d "$LOCK_ROOT/$serial" ]] || die "extend-stay: no lock for $serial"
  local lock_owner
  lock_owner="$(meta_get "$serial" OWNER_ID)"
  [[ -z "$lock_owner" || "$lock_owner" == "$(owner_id)" ]] || die "extend-stay: $serial is owned by another agent"
  touch "$LOCK_ROOT/$serial/last_used"
}

cmd_status() {
  mkdir -p "$LOCK_ROOT"
  local booted d serial avd branch age state h oid
  booted="$(adb_booted_serials || true)"
  printf '%-16s %-24s %-30s %-10s %-8s %s\n' "SERIAL" "AVD" "OWNER (branch)" "OWNER_ID" "IDLE" "DEVICE"
  local found=0
  for d in "$LOCK_ROOT"/emulator-*; do
    [[ -d "$d" ]] || continue
    found=1
    serial="$(basename "$d")"
    avd="$(meta_get "$serial" AVD)"
    branch="$(meta_get "$serial" OWNER_BRANCH)"
    oid="$(meta_get "$serial" OWNER_ID)"
    age="$(lease_age "$serial")"
    if [[ -n "$age" ]]; then h="$(( age / 60 ))m"; (( age >= 3600 )) && h="$(( age / 3600 ))h$(( (age % 3600) / 60 ))m"; else h="?"; fi
    if echo "$booted" | grep -qx "$serial"; then state="booted"
    elif adb_all_serials | grep -qx "$serial"; then state="offline"
    else state="absent"; fi
    is_stale "$serial" && state="$state (STALE)"
    if is_pool_lock "$serial"; then
      avd="${avd:-?} (pool)"
      [[ "$(pool_snapshot_of "$serial")" == "$POOL_SNAPSHOT_WINDOW" ]] && avd="${avd%)}, window)"
    fi
    printf '%-16s %-24s %-30s %-10s %-8s %s\n' "$serial" "${avd:-?}" "${branch:-?}" "${oid:0:8}" "$h" "$state"
  done
  (( found )) || echo "(no locks)"
  # Unclaimed but running devices are the free pool.
  for serial in $booted; do
    [[ -d "$LOCK_ROOT/$serial" ]] && continue
    avd="$(avd_of_serial "$serial")"
    state="booted, UNCLAIMED (free)"
    is_pool_avd "$avd" && state="leftover pool instance, not reusable — reap shuts it down"
    printf '%-16s %-24s %-30s %-10s %-8s %s\n' "$serial" "$avd" "-" "-" "-" "$state"
  done
  if [[ -d "$AVD_HOME/$POOL_AVD.avd" ]]; then
    local snap="missing — emuriad pool bake" window=""
    pool_snapshot_ready && snap="ready"
    pool_snapshot_ready "$POOL_SNAPSHOT_WINDOW" && window=" · '$POOL_SNAPSHOT_WINDOW' ready (check-in --pool --window)"
    echo "agent pool: $(pool_lock_count)/$POOL_MAX claimed · AVD $POOL_AVD · snapshot '$POOL_SNAPSHOT' $snap$window"
  fi
}

cmd_reap() {
  mkdir -p "$LOCK_ROOT"
  reap_stale verbose
  echo "reap done."
}

# --- doctor (install) -----------------------------------------------------------

# Where the guard is wired, if anywhere: a settings.json that mentions emuriad,
# or one that runs a project hook script which itself calls `emuriad guard`.
# emulock is the pre-rename name, still wired through the shim.
RE_WIRED='(emuriad|emulock)-guard\.sh|(emuriad|emulock)[^"]* guard'
RE_WIRED_HOOK='(emuriad|emulock)[^[:space:]]* guard|(emuriad|emulock)-guard\.sh'
guard_wired_in() {
  local dir="$PWD" f hook_dir
  while [[ "$dir" != "/" ]]; do
    for f in "$dir/.claude/settings.json" "$dir/.claude/settings.local.json"; do
      [[ -f "$f" ]] || continue
      if grep -qE "$RE_WIRED" "$f" 2>/dev/null; then echo "$f"; return 0; fi
      hook_dir="$dir/.claude/hooks"
      if grep -q '\.claude/hooks/' "$f" 2>/dev/null && [[ -d "$hook_dir" ]] \
        && grep -lqE "$RE_WIRED_HOOK" "$hook_dir"/* 2>/dev/null; then
        echo "$f (through a hook in $hook_dir)"; return 0
      fi
    done
    dir="$(dirname "$dir")"
  done
  for f in "$HOME/.claude/settings.json" "$HOME/.claude/settings.local.json"; do
    [[ -f "$f" ]] && grep -qE "$RE_WIRED" "$f" 2>/dev/null && { echo "$f"; return 0; }
  done
  return 1
}

# Report whether enforcement is actually wired up, and print the fix if it is
# not. Strictly read-only.
cmd_doctor_install() {
  local problems=0
  say() { printf '  %s  %s\n' "$1" "$2"; }
  good() { say "ok  " "$1"; }
  warn() { problems=$((problems + 1)); say "WARN" "$1"; }

  echo "emuriad doctor ($VERSION)"
  echo

  # jq first: it is the one missing dependency that fails *silently*. The guard
  # parses the harness payload with it, and a failed parse exits 0 -- which a
  # PreToolUse hook means as "allow". So without jq every command is permitted
  # and nothing warns you. It cannot fail closed instead, because a hook that
  # denies on its own breakage would block every shell command on the machine
  # with no way to repair it. Hence: fail open, and catch it here.
  if command -v jq >/dev/null 2>&1; then
    good "jq found ($(command -v jq))"
  else
    warn "jq NOT FOUND — the guard cannot parse the harness payload, so it allows
         everything and says nothing. Locks are advisory until you install it:
             macOS:  brew install jq
             Debian: sudo apt install jq"
  fi

  command -v python3 >/dev/null 2>&1 && good "python3 found" || warn "python3 not on PATH (needed by doctor <serial>, evidence and emuriad-lab)"
  command -v adb >/dev/null 2>&1 && good "adb found" || warn "adb not on PATH — install Android platform-tools"
  [[ -d "$SDK" ]] && good "Android SDK at $SDK" || warn "no SDK at $SDK — set ANDROID_HOME"

  if mkdir -p "$LOCK_ROOT" 2>/dev/null && [[ -w "$LOCK_ROOT" ]]; then
    good "lock store writable: $LOCK_ROOT"
  else
    warn "lock store not writable: $LOCK_ROOT"
  fi

  local owner; owner="$(owner_id)"
  case "$owner" in
    manual:*) warn "identity is '$owner' — advisory only, nothing will be blocked.
         Enforcement needs a harness that exposes a per-session id, or set
         EMULATOR_LOCK_OWNER yourself." ;;
    *) good "session identity: $owner" ;;
  esac

  local guard="" wired=""
  guard="$(guard_path || true)"
  if [[ -z "$guard" ]]; then
    warn "guard hook not found — reinstall emuriad"
  elif [[ ! -x "$guard" ]]; then
    warn "guard found but not executable: chmod +x '$guard'"
  else
    good "guard hook present"
    if wired="$(guard_wired_in)"; then
      good "wired into $wired"
    else
      warn "guard is NOT wired into any settings.json above $PWD or in ~/.claude.
         Locks are advisory until it is. Run this yourself — emuriad asks before it
         edits a settings file, and an agent should not do it for you:

             emuriad init"
    fi
  fi

  local conf; conf="$(conf_dir "$(project_root)")/config"
  if [[ -f "$conf" ]]; then
    case "$conf" in
      */.emulock/config) good "project config: $conf (pre-rename name; git mv .emulock .emuriad when convenient)" ;;
      *) good "project config: $conf" ;;
    esac
  fi

  echo
  if (( problems )); then
    echo "$problems issue(s). emuriad still coordinates, but nothing is enforced"
    echo "until the warnings above are resolved."
    return 1
  fi
  echo "All good — reservations are enforced on this machine."
  return 0
}

cmd_doctor() {
  # No serial: is emuriad itself installed and enforced? A serial: is this device ready?
  if [[ $# -eq 0 ]]; then
    cmd_doctor_install
    return
  fi
  local py
  py="$(libexec_path emuriad_doctor.py)" || die "doctor: libexec/emuriad_doctor.py is missing — reinstall emuriad"
  exec python3 "$py" "$@"
}

# --- dispatch to the other tools ------------------------------------------------

cmd_pool() {
  local sh
  sh="$(libexec_path emuriad-pool.sh)" || die "pool: libexec/emuriad-pool.sh is missing — reinstall emuriad"
  EMURIAD_BIN="$SELF" EMURIAD_DRY_RUN="$DRY_RUN" exec /bin/bash "$sh" "$@"
}

cmd_evidence() {
  local py
  py="$(libexec_path emuriad_evidence.py)" || die "evidence: libexec/emuriad_evidence.py is missing — reinstall emuriad"
  exec python3 "$py" "$@"
}

cmd_init() {
  local py invoked skill
  py="$(libexec_path emuriad_init.py)" || die "init: libexec/emuriad_init.py is missing — reinstall emuriad"
  # Link the skill through the path emuriad was invoked by, when that has a share
  # dir (Homebrew: /opt/homebrew/share/emuriad). The resolved path is versioned
  # (Cellar/emuriad/0.2.0/...), and an upgrade would leave the link dangling.
  invoked="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  skill="$(first_existing "$invoked/../share/emuriad/skills/emuriad" || share_path skills/emuriad || true)"
  EMURIAD_BIN="$SELF" EMURIAD_SKILL_DIR="$skill" exec python3 "$py" "$@"
}

main() {
  # The hook runs before every shell command, so it skips everything else here.
  if [[ "${1:-}" == "guard" ]]; then
    local guard
    guard="$(guard_path)" || exit 0   # nothing to enforce with: fail open, `doctor` reports it
    exec /bin/bash "$guard"
  fi
  # Subcommands with their own --help and --dry-run get their arguments untouched.
  case "${1:-}" in
  pool) shift; cmd_pool "$@" ;;
  evidence) shift; cmd_evidence "$@" ;;
  init) shift; cmd_init "$@" ;;
  doctor) if [[ $# -gt 1 ]]; then shift; cmd_doctor "$@"; fi ;;
  esac
  load_pool_config

  local args=() a cmd=""
  for a in "$@"; do
    case "$a" in
    --help|-h) usage; exit 0 ;;
    --version) echo "emuriad $VERSION"; exit 0 ;;
    --dry-run) DRY_RUN=1 ;;
    *) args+=("$a") ;;
    esac
  done
  set -- ${args[@]+"${args[@]}"}
  cmd="${1:-}"
  [[ -n "$cmd" ]] || { usage; exit 1; }
  shift
  case "$cmd" in
  version) echo "emuriad $VERSION"; return 0 ;;
  doctor) cmd_doctor "$@"; return ;;
  esac
  require_adb
  case "$cmd" in
  check-in|claim) cmd_claim "$@" ;;
  reclaim) cmd_reclaim "$@" ;;
  check-out|release) cmd_release "$@" ;;
  extend-stay|heartbeat) cmd_heartbeat "$@" ;;
  status) cmd_status "$@" ;;
  reap) cmd_reap "$@" ;;
  *) die "unknown command: $cmd (check-in|reclaim|check-out|extend-stay|status|reap|pool|doctor|evidence|init|guard|version)" ;;
  esac
}

main "$@"
